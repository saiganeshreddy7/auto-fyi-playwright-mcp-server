# Backend: Cloudflare tunnel to the local machine running the Playwright automation.
AUTOFYI_API_BASE=https://autofyi.kellyautomations.com

# Financial writes are OFF unless this is explicitly changed to true.
AUTOFYI_ENABLE_WRITES=false

# stdio for local Claude. streamable-http for the hosted (Render) team server.
AUTOFYI_MCP_TRANSPORT=stdio

# Required for streamable-http: the MCP is served at /mcp/<secret>.
# Anyone with the full URL can use the server, so treat it like a password.
AUTOFYI_MCP_PATH_SECRET=

# Optional: Cloudflare Access service token protecting the tunnel.
AUTOFYI_CF_ACCESS_CLIENT_ID=
AUTOFYI_CF_ACCESS_CLIENT_SECRET=
